    // @User: Advanced
    AP_GROUPINFO("ENABLE", 1, AP_TiltHexa, _enable, 0),

    // @Param: ALLOC_MODE
    // @DisplayName: Allocation mode
    // @Description: 0=weighted pseudoinverse + clipping, 1=constrained WLS/QP
