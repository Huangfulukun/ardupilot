# Joby S4 concept SITL defaults
#
# Uses ArduPlane's Hexa/X mixer for the six propulsion stations and
# vectored-yaw tiltrotor support for left/right grouped nacelle tilt.
# These are simulation starting values, not Joby production parameters.

Q_ENABLE         1
Q_FRAME_CLASS    2
Q_FRAME_TYPE     22

Q_TILT_ENABLE    1
Q_TILT_TYPE      0
Q_TILT_MASK      63
Q_TILT_RATE_UP   25
Q_TILT_RATE_DN   25
Q_TILT_MAX       60

# No separate forward motor; the six tilt-propellers provide cruise thrust.
SERVO3_FUNCTION  0

# QuadPlane motor outputs occupy SERVO5..SERVO10.
# All six propulsion stations share ArduPlane's continuous collective tilt
# output in this baseline model.
SERVO12_FUNCTION 41
SERVO12_MIN      1000
SERVO12_MAX      2000

# Full-scale concept electrical model.
SIM_BATT_VOLTAGE 850
Q_M_BAT_VOLT_MAX 900
Q_M_BAT_VOLT_MIN 650
Q_M_PWM_MIN      1000
Q_M_PWM_MAX      2000
Q_M_THST_EXPO    0.35

# Public Joby performance is up to about 200 mph.  These values make
# transition/cruise testing practical while retaining a realistic envelope.
AIRSPEED_MIN     25
AIRSPEED_CRUISE  55
AIRSPEED_MAX     90
Q_ASSIST_SPEED   25

# Conservative initial attitude gains for the high-inertia full-scale model.
Q_A_ANG_RLL_P    4.0
Q_A_ANG_PIT_P    4.0
Q_A_ANG_YAW_P    3.0
Q_A_RAT_RLL_P    0.08
Q_A_RAT_RLL_I    0.08
Q_A_RAT_RLL_D    0.002
Q_A_RAT_PIT_P    0.08
Q_A_RAT_PIT_I    0.08
Q_A_RAT_PIT_D    0.002
Q_A_RAT_YAW_P    0.15
Q_A_RAT_YAW_I    0.02
